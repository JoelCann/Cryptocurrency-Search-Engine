{"ast":null,"code":"import{useEffect}from'react';export var useOnKeyPress=function useOnKeyPress(callback,targetkey){useEffect(function(){var keyPressHandler=function keyPressHandler(event){if(event.key===targetkey){callback();}};window.addEventListener('keydown',keyPressHandler);return function(){window.removeEventListener('keydown',keyPressHandler);};},[callback,targetkey]);};","map":{"version":3,"names":["useEffect","useOnKeyPress","callback","targetkey","keyPressHandler","event","key","window","addEventListener","removeEventListener"],"sources":["/Users/administrator/React_Projects/Git/Cryptocurrency-Search-Engine/src/Hooks/useOnKeyPress.js"],"sourcesContent":["import { useEffect } from 'react'\n\nexport const useOnKeyPress = (callback, targetkey) => {\n    useEffect(() => {\n\n        const keyPressHandler = (event) => {\n            if (event.key === targetkey) {\n                callback();\n            }\n        }\n\n        window.addEventListener('keydown', keyPressHandler);\n        return () => {\n            window.removeEventListener('keydown', keyPressHandler);\n        };\n    }, [callback, targetkey]);\n\n}"],"mappings":"AAAA,OAASA,SAAS,KAAQ,OAAO,CAEjC,MAAO,IAAM,CAAAC,aAAa,CAAG,QAAhB,CAAAA,aAAaA,CAAIC,QAAQ,CAAEC,SAAS,CAAK,CAClDH,SAAS,CAAC,UAAM,CAEZ,GAAM,CAAAI,eAAe,CAAG,QAAlB,CAAAA,eAAeA,CAAIC,KAAK,CAAK,CAC/B,GAAIA,KAAK,CAACC,GAAG,GAAKH,SAAS,CAAE,CACzBD,QAAQ,CAAC,CAAC,CACd,CACJ,CAAC,CAEDK,MAAM,CAACC,gBAAgB,CAAC,SAAS,CAAEJ,eAAe,CAAC,CACnD,MAAO,WAAM,CACTG,MAAM,CAACE,mBAAmB,CAAC,SAAS,CAAEL,eAAe,CAAC,CAC1D,CAAC,CACL,CAAC,CAAE,CAACF,QAAQ,CAAEC,SAAS,CAAC,CAAC,CAE7B,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}